{
  "name": "pane-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Pane: one shared desktop runtime (Chromium + Node) for many small apps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Av3nger123/pane"
  },
  "pane": {
    "distributionUrl": "https://github.com/Av3nger123/pane/releases/download",
    "releaseKeys": []
  },
  "bin": {
    "pane": "bin/pane.js"
  },
  "main": "sdk/backend/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./sdk/backend/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "main.js",
    "bin",
    "src",
    "sdk",
    "templates",
    "types",
    "assets",
    "installer/windows/PaneSetup.cs",
    "installer/windows/build.js",
    "installer/windows/PaneSetup.exe",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/unit/*.test.js",
    "smoke": "node test/e2e/smoke.js",
    "test:templates": "node test/e2e/templates.js",
    "test:notes": "node test/e2e/notes.js",
    "test:installers": "node test/e2e/installers.js"
  },
  "dependencies": {
    "electron": "45.2.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3"
  }
}
